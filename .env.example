# Copy to .env and fill in real values. Never commit .env.

# --- Gemini ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Postgres ---
# Used by both the ingestion pipeline and the FastAPI server.
# These match docker-compose.yml defaults; override if you change them there.
POSTGRES_USER=secrag
POSTGRES_PASSWORD=secrag
POSTGRES_DB=secrag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://secrag:secrag@localhost:5432/secrag

# --- SEC EDGAR ---
# SEC requires a User-Agent with contact info on every request.
# Format: "Name email@example.com"
SEC_USER_AGENT=Your Name your.email@example.com

# --- API ---
# URL the Next.js proxy hits. Set in web/.env.local in Phase 7.
API_BASE_URL=http://localhost:8000
