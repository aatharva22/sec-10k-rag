# Data — downloaded filings are large and reproducible from EDGAR.
# Keep manifest.json in git: it's the record of which exact filings we used
# (URLs + sha256s for reproducibility); the HTML itself is gitignored.
data/filings/*
!data/filings/.gitkeep
!data/filings/manifest.json

